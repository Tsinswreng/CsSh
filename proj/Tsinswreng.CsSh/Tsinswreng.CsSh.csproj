<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<!-- C# 14 extension operators used by Cssh require the net10.0 compiler/runtime surface. -->
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>

		<!-- NuGet package identity and discovery metadata. -->
		<PackageId>Tsinswreng.CsSh</PackageId>
		<Version>0.2.0-alpha</Version>
		<Authors>Tsinswreng</Authors>
		<Description>A cross-platform, NativeAOT-compatible C# shell infrastructure library for build, release, synchronization, and toolchain scripts.</Description>
		<PackageTags>shell;process;filesystem;script;csx;nativeaot;cross-platform</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Copyright>Copyright (c) 2026 Tsinswreng</Copyright>
		<PackageProjectUrl>https://github.com/Tsinswreng/CsSh</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Tsinswreng/CsSh</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Produce debuggable packages without coupling ordinary builds to packing. -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSource>true</IncludeSource>
		<DebugType>portable</DebugType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- Parses and enumerates glob patterns without translating them to regular expressions. -->
		<PackageReference Include="Meziantou.Framework.Globbing" Version="5.0.0" />
	</ItemGroup>

</Project>
